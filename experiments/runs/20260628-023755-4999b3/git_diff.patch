+   "source": "from src import blending as bl\n\n# Build the six headline blends from the SAME logged OOF the cells above used. The\n# Optuna LGBM-stack params are reused from `study` above so this cell does not re-tune.\ntest_df = pd.DataFrame({lab: test_col(lab) for lab in oof.columns})\nblends = bl.build_headline_blends(oof, test_df, meta, CURATED, FULL, y, folds,\n                                  lgbm_stack_params=study.best_params)\n\n# Per-fold significance table (technical_review.md §2.2): read each blend's gain over\n# the best single member against that member's own per-fold std (~0.0009 — the noise\n# floor). |gain_in_fold_stds| < 1 means the gain sits inside CV noise.\nbase_fold_std = bl.fold_aucs(oof[curated_meta.iloc[0][\"label\"]].to_numpy(), y, folds)[2]\ntable = bl.summarize_blends(blends, y, folds, best_single, base_fold_std)\n\nprint(f\"best single member: {curated_meta.iloc[0]['label']}  OOF {best_single:.6f}  \"\n      f\"(per-fold std {base_fold_std:.6f} = noise floor)\\n\")\nprint(table.to_string(index=False, formatters={\n    \"oof_roc_auc\": \"{:.6f}\".format, \"fold_mean\": \"{:.6f}\".format,\n    \"fold_std\": \"{:.6f}\".format, \"vs_best_single\": \"{:+.6f}\".format,\n    \"gain_in_fold_stds\": \"{:+.2f}\".format}))\nprint(\"\\nLogged + submitted as runs.csv entries via:  \"\n      \"python scripts/run_blend_logging.py --submit\")",
