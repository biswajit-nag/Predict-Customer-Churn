+   "source": [
+    "import optuna\n",
+    "from lightgbm import LGBMClassifier\n",
+    "from sklearn.model_selection import cross_val_score\n",
+    "\n",
+    "optuna.logging.set_verbosity(optuna.logging.WARNING)\n",
+    "\n",
+    "inner_cv = StratifiedKFold(n_splits=3, shuffle=True, random_state=42)  # matches src/tuning.py\n",
+    "\n",
+    "\n",
+    "def lgbm_refined_objective(trial):\n",
+    "    params = {\n",
+    "        'n_estimators':      trial.suggest_int('n_estimators', 400, 1500),\n",
+    "        'learning_rate':     trial.suggest_float('learning_rate', 0.05, 0.3, log=True),\n",
+    "        'max_depth':         trial.suggest_int('max_depth', 3, 6),\n",
+    "        'num_leaves':        trial.suggest_int('num_leaves', 8, 64),\n",
+    "        'min_child_samples': trial.suggest_int('min_child_samples', 20, 150),\n",
+    "        'min_split_gain':    trial.suggest_float('min_split_gain', 0.3, 2.0),\n",
+    "        'subsample':         trial.suggest_float('subsample', 0.5, 0.9),\n",
+    "        'subsample_freq':    1,   # must be >0 for subsample to apply; not tunable\n",
+    "        'colsample_bytree':  trial.suggest_float('colsample_bytree', 0.4, 0.8),\n",
+    "        'reg_alpha':         trial.suggest_float('reg_alpha', 1e-8, 1.0, log=True),\n",
+    "        'reg_lambda':        trial.suggest_float('reg_lambda', 1e-3, 10.0, log=True),\n",
+    "        'verbose':           -1,  # not tunable\n",
+    "    }\n",
+    "    scores = cross_val_score(LGBMClassifier(**params), X_train, y_train,\n",
+    "                             cv=inner_cv, scoring='roc_auc')\n",
+    "    return scores.mean()\n",
+    "\n",
+    "\n",
+    "lgbm_study = optuna.create_study(\n",
+    "    study_name='lgbm-refined',\n",
+    "    direction='maximize',\n",
+    "    sampler=optuna.samplers.TPESampler(seed=42),\n",
+    ")\n",
+    "\n",
+    "# Trial 0 reproduces the e4e8d5d optimum so the study starts at the known best.\n",
+    "# num_leaves is clipped into the new range: at max_depth=4 (<=16 leaves) any\n",
+    "# value >=16 is equivalent to the original 249.\n",
+    "lgbm_study.enqueue_trial({\n",
+    "    'n_estimators':      874,\n",
+    "    'learning_rate':     0.15197855742746597,\n",
+    "    'max_depth':         4,\n",
+    "    'num_leaves':        64,\n",
+    "    'min_child_samples': 66,\n",
+    "    'min_split_gain':    0.8858452764689357,\n",
+    "    'subsample':         0.6227117340541225,\n",
+    "    'colsample_bytree':  0.5934539080388056,\n",
+    "    'reg_alpha':         3.357139007724072e-06,\n",
+    "    'reg_lambda':        0.4039666555111604,\n",
+    "})\n",
+    "\n",
+    "lgbm_study.optimize(lgbm_refined_objective, n_trials=50, show_progress_bar=True)\n",
+    "\n",
+    "print(f'Best inner-CV ROC AUC: {lgbm_study.best_value:.6f}  (trial {lgbm_study.best_trial.number})')\n",
+    "for k, v in lgbm_study.best_params.items():\n",
+    "    print(f'  {k:18s} {v}')"
+   ]
+  },
