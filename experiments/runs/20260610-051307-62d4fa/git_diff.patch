-   "source": "# --- XGBoost run setup ---\nfrom xgboost import XGBClassifier\n\n# Align the test frame's categorical codes to the training frame's. Unlike\n# LightGBM (which stores pandas_categorical and remaps at predict time), XGBoost's\n# native categorical path reads the pandas .cat.codes directly and does NOT realign\n# across frames. service_profile in particular has a slightly different category set\n# in train vs test (327 vs 325 levels), so without this the bagged test predictions\n# would read mismatched codes for that column. set_categories maps the shared levels\n# onto the train codes and turns test-only, unseen levels into NaN — which XGBoost\n# handles as missing, exactly the semantics we want. OOF scores are unaffected (the\n# fold loop only ever predicts on X_train slices, which already share one category\n# dtype). Idempotent: safe to re-run.\nX_test = X_test.copy()\nfor _col in X_test.columns:\n    if isinstance(X_test[_col].dtype, pd.CategoricalDtype):\n        X_test[_col] = X_test[_col].cat.set_categories(X_train[_col].cat.categories)"
+   "source": [
+    "# --- XGBoost run setup ---\n",
+    "from xgboost import XGBClassifier\n",
+    "\n",
+    "# Align the test frame's categorical codes to the training frame's. Unlike\n",
+    "# LightGBM (which stores pandas_categorical and remaps at predict time), XGBoost's\n",
+    "# native categorical path reads the pandas .cat.codes directly and does NOT realign\n",
+    "# across frames. service_profile in particular has a slightly different category set\n",
+    "# in train vs test (327 vs 325 levels), so without this the bagged test predictions\n",
+    "# would read mismatched codes for that column. set_categories maps the shared levels\n",
+    "# onto the train codes and turns test-only, unseen levels into NaN — which XGBoost\n",
+    "# handles as missing, exactly the semantics we want. OOF scores are unaffected (the\n",
+    "# fold loop only ever predicts on X_train slices, which already share one category\n",
+    "# dtype). Idempotent: safe to re-run.\n",
+    "X_test = X_test.copy()\n",
+    "for _col in X_test.columns:\n",
+    "    if isinstance(X_test[_col].dtype, pd.CategoricalDtype):\n",
+    "        X_test[_col] = X_test[_col].cat.set_categories(X_train[_col].cat.categories)"
+   ]
