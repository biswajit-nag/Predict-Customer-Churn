fier(**params), X_train, y_train,\n                             cv=inner_cv, scoring='roc_auc')\n    return scores.mean()\n\n\nxgb_study = optuna.create_study(\n    study_name='xgb-refined-fe_v3',\n    direction='maximize',\n    sampler=optuna.samplers.TPESampler(seed=42),\n)\n\n# Trial 0 reproduces the 20260530-234246-15ca1c optimum (xgb-optuna-acc best\n# params) so the study starts at that config on the inner-CV metric.\nxgb_study.enqueue_trial({\n    'n_estimators':     873,\n    'learning_rate':    0.09133028874724348,\n    'max_depth':        4,\n    'min_child_weight': 19,\n    'subsample':        0.8510909128071904,\n    'colsample_bytree': 0.7589777382360683,\n    'reg_alpha':        0.002637085557426338,\n    'reg_lambda':       0.03775135119210578,\n    'gamma':            0.0015592150348604644,\n})\n\nxgb_study.optimize(xgb_refined_objective, n_trials=50, show_progress_bar=True)\n\nprint(f'Best inner-CV ROC AUC: {xgb_study.best_value:.6f}  (trial {xgb_study.best_trial.number})')\nfor k, v in xgb_study.best_params.items():\n    print(f'  {k:18s} {v}')"
