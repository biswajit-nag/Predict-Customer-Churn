    trial.suggest_int('n_estimators', 400, 1500),\n        'learning_rate':    trial.suggest_float('learning_rate', 0.01, 0.3, log=True),\n        'max_depth':        max_depth,\n        # Dynamic upper bound: only leaf counts a depth-max_depth tree can actually reach.\n        'max_leaves':       trial.suggest_int('max_leaves', 4, min(2 ** max_depth, 255)),\n        'min_child_weight': trial.suggest_int('min_child_weight', 1, 30),\n        'subsample':        trial.suggest_float('subsample', 0.5, 1.0),\n        'colsample_bytree': trial.suggest_float('colsample_bytree', 0.4, 0.9),\n        'reg_alpha':        trial.suggest_float('reg_alpha', 1e-8, 10.0, log=True),\n        'reg_lambda':       trial.suggest_float('reg_lambda', 1e-3, 10.0, log=True),\n        'gamma':            trial.suggest_float('gamma', 1e-8, 1.0, log=True),\n        **XGB_FIXED,\n    }\n    scores = cross_val_score(XGBClassifier(**params), X_train, y_train,\n                             cv=inner_cv, scoring='roc_auc')\n    return scores.mean()\n\n\nxgb_study = optuna.create_study(\n    study_name='xgb-coupled-fe_v4',\n    direction='maximize',\n    sampler=optuna.samplers.TPESampler(seed=42),\n)\n\n# Trial 0 reproduces the best XGB config to date (run 20260610-051307-62d4fa,\n# xgb-refined-best-fe_v3) so the search starts from a strong point:\n#   - max_leaves 64: at max_depth=6 a full tree has 2**6 = 64 leaves, so under lossguide\n#     max_leaves=64 is non-binding and reproduces that run's depthwise-equivalent full\n#     tree. (An out-of-range enqueued value would be silently re-sampled by Optuna.)\n# The feature set differs (that run was fe_v3), so the inner-CV score won't match exactly.\nxgb_study.enqueue_trial({\n    'n_estimators':     1294,\n    'learning_rate':    0.02478628356824863,\n    'max_depth':        6,\n    'max_leaves':       64,\n    'min_child_weight': 29,\n    'subsample':        0.7435546846646213,\n    'colsample_bytree': 0.45206664635880095,\n    'reg_alpha':        9.428542188325682,\n    'reg_lambda':       1.2585761748859978,\n    'gamma':            0.002029279492295108,\n})\n\nxgb_study.optimize(xgb_objective, n_trials=60, show_progress_bar=True)\n\nprint(f'Best inner-CV ROC AUC: {xgb_study.best_value:.6f}  (trial {xgb_study.best_trial.number})')\nfor k, v in xgb_study.best_params.items():\n    print(f'  {k:18s} {v}')"
