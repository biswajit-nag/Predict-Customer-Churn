+   "source": [
+    "# --- XGBoost run setup: align test categorical codes to train ---\n",
+    "# Unlike LightGBM (which stores pandas_categorical and remaps by category value at predict\n",
+    "# time), XGBoost's native categorical path reads the pandas .cat.codes directly and does\n",
+    "# NOT realign across frames. If train and test have even slightly different category sets\n",
+    "# for a column, the same integer code would mean different things, so the bagged test\n",
+    "# predictions would read mismatched codes. set_categories maps the test frame onto the\n",
+    "# train categories — shared levels keep the train code, test-only levels become NaN, which\n",
+    "# XGBoost handles as missing (exactly the semantics we want). OOF scores are unaffected\n",
+    "# (the fold loop only ever predicts on X_train slices, which already share one category\n",
+    "# dtype). Idempotent: safe to re-run.\n",
+    "X_test = test_df[encoded_features].copy()\n",
+    "for _col in X_test.columns:\n",
+    "    if isinstance(X_test[_col].dtype, pd.CategoricalDtype):\n",
+    "        X_test[_col] = X_test[_col].cat.set_categories(X_train[_col].cat.categories)"
