fier(**params), X_train, y_train,\n                             cv=inner_cv, scoring='roc_auc')\n    return scores.mean()\n\n\nlgbm_study = optuna.create_study(\n    study_name='lgbm-refined-fe_v3',\n    direction='maximize',\n    sampler=optuna.samplers.TPESampler(seed=42),\n)\n\n# Trial 0 reproduces the 20260609-222839-80b124 optimum (lgbm-refined-best params) so\n# the study starts at that config on the inner-CV metric. The search bounds were widened\n# (n_estimators up to 1500) so this seed sits strictly inside the space.\nlgbm_study.enqueue_trial({\n    'n_estimators':      1310,\n    'learning_rate':     0.05582055958441355,\n    'num_leaves':        32,\n    'max_depth':         4,\n    'min_child_samples': 68,\n    'subsample':         0.8714292912804658,\n    'colsample_bytree':  0.5758016735537286,\n    'reg_alpha':         0.8705806473560297,\n    'reg_lambda':        0.009553349549964198,\n    'min_split_gain':    0.4839131554160747,\n})\n\nlgbm_study.optimize(lgbm_refined_objective, n_trials=50, show_progress_bar=True)\n\nprint(f'Best inner-CV ROC AUC: {lgbm_study.best_value:.6f}  (trial {lgbm_study.best_trial.number})')\nfor k, v in lgbm_study.best_params.items():\n    print(f'  {k:18s} {v}')"
