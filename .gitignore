# --- Environment / tooling ---------------------------------------------------
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
catboost_info/
.claude/
CLAUDE.md

# --- Data: fetched from Kaggle (data/fetch_data.py), never committed ----------
data/*.csv
data/*.zip
data/raw/
# Encoded / feature-engineered caches, regenerated by prepare_data() and
# src/features.py::build_features()
data/processed/

# --- Experiment artifacts ------------------------------------------------------
# The ledger (experiments/runs.csv), the fold map and each run's small text
# artifacts (params, metrics, notes, git diff, environment) are tracked.
# Prediction arrays and fitted models are large and regenerable, so they are not.
*.npy
*.joblib
experiments/runs/*/models/
experiments/optuna_studies/
submission*.csv

# --- Documentation: only the curated, public docs are tracked -----------------
docs/*
!docs/stacking_experiments.md
!docs/feature_engineering.md
!docs/experiment_tracking.md
!docs/top_solutions_analysis.md
!docs/commit_map.txt
!docs/reference/

# --- Local scratch -------------------------------------------------------------
/kaggle/
Others/
Latest Kaggle Runs/
